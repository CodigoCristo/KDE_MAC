 <stuff category="706">
  <name>Kpple Menu 6</name>
  <providerid>api.kde-look.org</providerid>
  <author>chrtall</author>
  <homepage>https://store.kde.org/p/2164679</homepage>
  <licence></licence>
  <version>6.0.0</version>
